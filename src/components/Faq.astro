---
import { Icon } from 'astro-icon/components';
import { getCopy, langOf } from '../content/site';

const t = getCopy(langOf(Astro.url.pathname));
---

<section id="faq" class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 lg:py-28">
  <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <h2
      class="font-sans text-3xl font-semibold tracking-tight text-ink md:text-4xl"
      data-reveal
    >
      {t.faq.title}
    </h2>

    <div class="divide-y divide-line border-y border-line" data-reveal>
      {
        t.faq.items.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 [&::-webkit-details-marker]:hidden">
              <span class="font-sans text-base font-medium text-ink">{item.q}</span>
              <Icon
                name="ph:caret-down"
                class="size-4 shrink-0 text-muted transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="mt-3 max-w-[65ch] text-sm leading-relaxed text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
