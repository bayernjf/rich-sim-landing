---
import { milestones } from '../content/site';
---

<section class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 lg:py-28">
  <div class="max-w-[60ch]" data-reveal>
    <h2 class="font-sans text-3xl font-semibold tracking-tight text-ink md:text-4xl">
      {milestones.title}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-muted">{milestones.lead}</p>
  </div>

  <ol class="mt-12 space-y-4">
    {
      milestones.steps.map((step, i) => (
        <li
          class="grid gap-4 rounded-2xl border border-line bg-panel p-6 md:grid-cols-[auto_1fr_1fr] md:items-center md:gap-8 lg:p-7"
          style={`--reveal-delay:${i * 80}ms`}
          data-reveal
        >
          <span class="num text-2xl font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <p class="font-sans text-lg font-semibold text-ink">{step.verb}</p>
            <p class="mt-1 text-sm text-muted">{step.detail}</p>
          </div>
          <p class="text-sm leading-relaxed text-muted md:border-l md:border-line md:pl-8">
            {step.action}
          </p>
        </li>
      ))
    }
  </ol>

  <p class="mt-4 text-xs text-muted">{milestones.note}</p>
</section>
