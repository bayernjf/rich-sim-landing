---
import { Icon } from 'astro-icon/components';
import { getCopy, langOf } from '../content/site';

const t = getCopy(langOf(Astro.url.pathname));
const openLabel = langOf(Astro.url.pathname) === 'zh' ? '打开菜单' : 'Open menu';
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-4 sm:px-6">
    <a href="#top" class="flex shrink-0 items-center gap-2">
      <span class="grid size-7 place-items-center rounded-md bg-accent text-on-accent">
        <Icon name="ph:chart-line-up" class="size-4" />
      </span>
      <span class="font-sans text-[15px] font-semibold tracking-tight text-ink">{t.brand.name}</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        t.nav.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-muted transition-colors hover:text-ink">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href="#calc"
        class="hidden rounded-full bg-ink px-4 py-2 text-sm font-medium text-canvas transition-transform hover:brightness-95 active:scale-[0.98] sm:inline-flex"
      >
        {t.cta.calc}
      </a>
      <button
        type="button"
        id="nav-toggle"
        aria-label={openLabel}
        aria-expanded="false"
        class="grid size-9 place-items-center rounded-lg border border-line text-ink md:hidden"
      >
        <Icon name="ph:list" class="size-5" />
      </button>
    </div>
  </nav>

  <div id="nav-panel" hidden class="border-t border-line bg-canvas px-4 py-3 md:hidden">
    <ul class="flex flex-col">
      {
        t.nav.map((item) => (
          <li>
            <a href={item.href} class="block py-3 text-sm text-muted hover:text-ink">
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="#calc" class="mt-2 block rounded-full bg-ink px-4 py-2.5 text-center text-sm font-medium text-canvas">
          {t.cta.calc}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');

  toggle?.addEventListener('click', () => {
    if (!panel) return;
    const open = panel.hasAttribute('hidden');
    if (open) {
      panel.removeAttribute('hidden');
    } else {
      panel.setAttribute('hidden', '');
    }
    toggle.setAttribute('aria-expanded', String(open));
  });

  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      panel.setAttribute('hidden', '');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
