---
import { Icon } from 'astro-icon/components';
import { getCopy, langOf } from '../content/site';

const t = getCopy(langOf(Astro.url.pathname));

const spanClass: Record<string, string> = {
  wide: 'lg:col-span-2',
  plain: '',
};
---

<section id="sim" class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 lg:py-28">
  <div class="max-w-[60ch]" data-reveal>
    <h2 class="font-sans text-3xl font-semibold tracking-tight text-ink md:text-4xl">
      {t.sim.title}
    </h2>
    <p class="mt-4 text-base leading-relaxed text-muted">{t.sim.lead}</p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      t.sim.tiles.map((tile, i) => (
        <article
          class:list={[
            'flex flex-col justify-between gap-8 rounded-2xl border p-6 lg:p-7',
            tile.tone === 'accent'
              ? 'border-accent/25 bg-gradient-to-br from-accent-soft to-transparent'
              : 'border-line bg-panel',
            spanClass[tile.span ?? 'plain'],
          ]}
          style={`--reveal-delay:${i * 70}ms`}
          data-reveal
        >
          <span
            class:list={[
              'grid size-11 place-items-center rounded-xl border',
              tile.tone === 'accent'
                ? 'border-accent/30 bg-accent/10 text-accent'
                : 'border-line bg-panel-2 text-ink',
            ]}
          >
            <Icon name={tile.icon} class="size-5" />
          </span>
          <div>
            <h3 class="font-sans text-lg font-semibold text-ink">{tile.title}</h3>
            <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-muted">{tile.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
